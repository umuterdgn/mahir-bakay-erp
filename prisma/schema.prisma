  equipment   String   // JSON array of equipment names or comma-separated list
  signature   String   // Dijital imza metni/hash'i
  date        DateTime @default(now())
  status      String   @default("Onaylandı")
  personelId  String
  personel    Personel @relation(fields: [personelId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([personelId])
  @@index([date])
  @@index([status])
}

// ============================================================================
// CONCRETE TEST (Beton Numune ve Karot)
// ============================================================================

model ConcreteTest {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id])
  castDate      DateTime // Beton Döküm Tarihi
  concreteClass String   // Örn: C30, C35
  element       String   // Örn: 1. Kat Kolonları, B Blok Tabliye
  waybillNo     String?  // İrsaliye No
  day7Result    Float?   // 7 Günlük Kırım Sonucu (MPa)
  day28Result   Float?   // 28 Günlük Kırım Sonucu (MPa)
  status        String   @default("BEKLIYOR") // BEKLIYOR, GECTI, KALDI, KAROT_ISTENDI
  reportUrl     String?  // Laboratuvar Raporu PDF
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([castDate])
  @@index([status])
}

model CoreTest {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  element     String   // Eleman adı
  location    String?  // Konum
  testDate    DateTime // Test tarihi
  strength    Float?   // Dayanım (MPa)
  status      String   @default("BEKLIYOR") // BEKLIYOR, GECTI, KALDI
  reportUrl   String?  // Rapor URL
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([testDate])
  @@index([status])
}

// ============================================================================
// DOCUMENT ARCHIVE (Ruhsat ve Evrak Arşivi)
// ============================================================================

model DocumentArchive {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String   // Örn: Yapı Ruhsatı, Zemin Etüdü
  category    String   // Örn: RUHSAT, PROJE_CIZIMI, TUTANAK
  fileUrl     String   // Cloudinary URL
  expiryDate  DateTime? // Varsa Geçerlilik Tarihi
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([category])
  @@index([expiryDate])
}

// ============================================================================
// PROJECT BLUEPRINT (Dijital Proje & Revizyon Takip)
// ============================================================================

model ProjectBlueprint {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  title       String   // Örn: A Blok Statik Aplikasyon Planı
  discipline  String   // MIMARI, STATIK, ELEKTRIK, MEKANIK
  revisionNo  String   // Örn: R0, R1, R2
  fileUrl     String   // PDF / Görsel URL
  isCurrent   Boolean  @default(true) // En güncel versiyon mu?
  uploadedBy  String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([discipline])
  @@index([isCurrent])
}

// ============================================================================
// REINFORCEMENT INSPECTION (Demir & Kalıp Kontrol)
// ============================================================================

model ReinforcementInspection {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  element        String   // Dökülecek Eleman
  status         String   @default("BEKLIYOR") // ONAYLANDI, REDDEDILDI, BEKLIYOR
  notes          String?  @db.Text
  photoUrl       String?  // Cloudinary URL
  inspectionDate DateTime @default(now())
  inspectorName  String?  // Kontrol Eden / Denetçi
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([projectId])
  @@index([inspectionDate])
  @@index([status])
}

// ============================================================================
// ATTACHMENT EVIDENCE (Ataşman & Dijital Delil)
// ============================================================================

model AttachmentEvidence {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title         String   // Başlık
  location      String   // Mahal/Konum Bilgisi
  description   String?  @db.Text
  photoUrl      String   // Cloudinary URL
  attachmentDate DateTime @default(now()) // Ataşmanın/Fotoğrafın çekildiği tarih
  createdBy     String?  // Ekleyen / Sorumlu kişi
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([projectId])
  @@index([attachmentDate])
}

// ============================================================================
// PROGRESS PAYMENT (Taşeron Hakediş Takibi)
// ============================================================================

model ProgressPayment {
  id              String   @id @default(cuid())
  projectId       String
  subcontractor   String   // Taşeron Firma / Kişi Adı
  workType        String   // Yapılan İş (Örn: Kalıp, Demir, Beton)
  unit            String   // Birim (m2, m3, ton, kg, adet)
  quantity        Float    // Miktar (Metraj)
  unitPrice       Float    // Birim Fiyat
  totalAmount     Float    // Toplam Tutar (quantity * unitPrice)
  status          String   @default("BEKLIYOR") // BEKLIYOR, ONAYLANDI, REDDEDILDI
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  financeTransaction Transaction?

  @@index([projectId])
  @@index([status])
  @@index([subcontractor])
}

// ============================================================================
// INVENTORY ITEM (Ambar & BLE Beacon Takibi)
// ============================================================================

model InventoryItem {
  id              String   @id @default(cuid())
  projectId       String
  name            String   // Örn: Çimento, Demir
  category        String   // Malzeme Kategorisi
  quantity        Float    // Miktar
  unit            String   // Birim (Adet, Ton, Paket)
  qrCode          String?  @unique // Normal QR Kod ID'si
  bleMacAddress   String?  @unique // BLE Sticker/Beacon MAC Adresi (ÖNEMLİ!)
  locationStatus  String   @default("DEPO") // DEPO, SAHADA, ZIMMETLI, KULLANILDI
  assignedTo      String?  // Zimmetlenen Kalfa/Usta
  lastSeenLat     Float?   // BLE'nin son görüldüğü enlem
  lastSeenLng     Float?   // BLE'nin son görüldüğü boylam
  lastSeenAt      DateTime @default(now())
  
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([locationStatus])
  @@index([bleMacAddress])
}

// ============================================================================
// QA/QC - YAPI DENETİM & KALİTE KONTROL
// ============================================================================

model MaterialSubmittal {
  id              String   @id @default(cuid())
  materialName    String   // Demir, Çimento, Seramik vs.
  brand           String   // Marka
  batchNumber     String?  // Parti Numarası
  tseCertificate  Boolean  @default(false)
  status          String   @default("Onay Bekliyor") // Onay Bekliyor, Onaylandı, Reddedildi
  inspectorName   String?  // Denetimci Adı
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model NonConformanceReport {
  id              String   @id @default(cuid())
  location        String   // Örn: A Blok, 3. Kat
  issueType       String   // Örn: Paspayı Yetersiz, Donatı Hatası
  description     String
  photoUrl        String?  // Hata fotoğrafı
  subcontractor   String   // İlgili Taşeron (Örn: Demirci Ekibi)
  status          String   @default("Açık") // Açık, İşlemde, Kapalı
  dueDate         DateTime? // Çözüm için son tarih
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([subcontractor])
  @@index([createdAt])
}

// ============================================================================
// İLETİŞİM & OPERASYONEL OTOMASYON
// ============================================================================

model ChatMessage {
  id              String   @id @default(cuid())
  senderId        String   // Gönderen Personel ID
  receiverId      String?  // Alıcı Personel ID (Birebir mesajsa)
  channelName     String?  // Grup mesajıysa (Örn: "Şantiye Şefleri", "İSG Acil Durum")
  content         String   @db.Text
  
  // Referans Mantığı (Veritabanını şişirmemek için)
  attachmentType  String?  // "NCR_REPORT", "ISG_ALARM", "MATERIAL_DOC" vb.
  attachmentRefId String?  // Var olan kaydın ID'si (Örn: NonConformanceReport ID'si)
  attachmentUrl   String?  // Sistemin içindeki route linki (Örn: /admin/qa-qc/ncr/123)
  
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([channelName])
  @@index([createdAt])
}

model LogisticsSchedule {
  id              String   @id @default(cuid())
  title           String   // Örn: "C30 Beton Dökümü - A Blok"
  type            String   // Örn: BETON, MALZEME_TESLİMAT, DENETİM
  location        String   // Şantiye içi konum
  supplierName    String?  // Tedarikçi/Firma Adı
  driverContact   String?  // Şoför/İrtibat no
  status          String   @default("Planlandı") // Planlandı, Yolda, Şantiyede, Tamamlandı, İptal
  scheduledAt     DateTime // Planlanan varış zamanı
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([scheduledAt])
  @@index([type])
}
