  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

// ============================================================================
// KKD (KİŞİSEL KORUYUCU DONANIM) DİJİTAL ZİMMET
// ============================================================================

model PPEDelivery {
